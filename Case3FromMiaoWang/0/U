FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (0 0 0);

boundaryField
{
    Diffuser
    {
        type            fixedValue;
        value           uniform (1.366 0 0);
    }
    Exhaust
    {
        //type            zeroGradient;
        type            inletOutlet;
		inletValue      uniform (0 0 0);
    }
    Box_north
    {
        type            fixedValue;
        value           uniform (0 0 0);
    }
    Box_south
    {
        type            fixedValue;
        value           uniform (0 0 0);
    }
    Box_east
    {
        type            fixedValue;
        value           uniform (0 0 0);
    }
    Box_west
    {
        type            fixedValue;
        value           uniform (0 0 0);
    }
    Box_top
    {
        type            fixedValue;
        value           uniform (0 0 0);
    }
    Ceiling
    {
        type            fixedValue;
        value           uniform (0 0 0);
    }
    Floor
    {
        type            fixedValue;
        value           uniform (0 0 0);
    }
    North_wall
    {
        type            fixedValue;
        value           uniform (0 0 0);
    }
    East_wall
    {
        type            fixedValue;
        value           uniform (0 0 0);
    }
    South_wall
    {
        type            fixedValue;
        value           uniform (0 0 0);
    }
    West_wall
    {
        type            fixedValue;
        value           uniform (0 0 0);
    }

}

